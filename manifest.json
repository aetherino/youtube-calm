{
  "manifest_version": 2,
  "name": "Calm YouTube",
  "version": "1.0.0",
  "description": "Replaces the YouTube home feed with a quiet, minimal search bar. Toggle back anytime.",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "browser_specific_settings": {
    "gecko": { "id": "calm-youtube@fztmon.local", "strict_min_version": "109.0" }
  },
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Calm YouTube"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Toggle calm mode on YouTube"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["calm.css"],
      "run_at": "document_start"
    }
  ]
}
